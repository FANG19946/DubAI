# test_gen_diarization
from speaker_utils import gen_dialogue_array  
from speaker_utils import extract_embedding, plot_speaker_embeddings     
from tqdm import tqdm

def main():
    # Load segmented dialogues
    base_wav_path = "data/wav/"  
    base_srt_path = "data/srt/"  

    segments = gen_dialogue_array(
        audio_path=  "eng_10_to_15.wav", 
        srt_path= "eng_10_to_15.srt"
    )

    print(f"Total segments: {len(segments)}")

    embeddings = []
    for idx, seg in enumerate(tqdm(segments, desc="Extracting Embeddings")):
        emb = extract_embedding(seg.audio)
        embeddings.append(emb)
        
    print("Embedding Extractions Complete")

    plot_speaker_embeddings(embeddings, "umap_clusters.png")



if __name__ == "__main__":
    main()
