from speaker_utils import gen_dialogue_array  # Your embedding function
from speaker_utils import extract_embedding     # Your segment generation function

def main():
    # Load segmented dialogues
    base_wav_path = "data/wav/"  
    base_srt_path = "data/srt/"  

    segments = gen_dialogue_array(
        audio_path=  "eng_10_to_15.wav",  # replace with actual filename
        srt_path= "eng_10_to_15.srt"
    )

    print(f"Total segments: {len(segments)}")

    for i in range(min(2, len(segments))):  # Only first 2 segments
        seg = segments[i]
        print(f"\n--- Segment {i} ---")
        print(f"Start: {seg.start} ms, End: {seg.end} ms")

        emb = extract_embedding(seg.audio)  # Your embedding extractor
        print("Embedding shape:", emb.shape)
        print("Embedding (first 5 values):", emb[:5])  # Preview first few values

if __name__ == "__main__":
    main()
